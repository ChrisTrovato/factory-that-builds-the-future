{
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/official_aero_plan",
      "destination": "/official_aero_plan/index.html"
    },
    {
      "source": "/official_aero_plan/",
      "destination": "/official_aero_plan/index.html"
    },
    {
      "source": "/factory/:path*",
      "destination": "/:path*"
    }
  ]
}
